import random

# List of prizes
prizes = ["Mug", "T-shirt", "Gift Card", "Nothing", "Lebron James"]

# Get user input
wheel = input("Big unlucky wheel! Type YES to spin: ").lower()
print("Congratulations, you spun:")

# Randomly pick a prize
result = random.choice(prizes)

# Check user input
if wheel in ["yes", "y", "sim", "s"]:
    print(result)
elif wheel in ["n", "no", "não", "nao"]:
    print("So you get: nothing, haha!!")
else:
    print("Can't even type properly, you LOSER!")
